{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillref:schema:skill-manifest:0.1",
  "title": "Skill manifest",
  "description": "Canonical semantic contract for one portable AI skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "license",
    "domains",
    "triggers",
    "risk",
    "permissions",
    "resources",
    "conflicts",
    "evaluation"
  ],
  "properties": {
    "$schema": { "const": "urn:skillref:schema:skill-manifest:0.1" },
    "schemaVersion": { "const": "0.1" },
    "id": { "$ref": "#/$defs/skillId" },
    "version": { "$ref": "#/$defs/semver" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 20, "maxLength": 1024 },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domainId" }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 500 }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "sideEffects", "rationale"],
      "properties": {
        "level": { "enum": ["low", "moderate", "high", "critical"] },
        "sideEffects": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 1000 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "resourceScopes"],
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "resourceScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resourceScope" }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "items"],
      "properties": {
        "entrypoint": { "$ref": "#/$defs/relativePath" },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "conflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "supersedes", "companions"],
      "properties": {
        "hard": { "$ref": "#/$defs/skillIdArray" },
        "supersedes": { "$ref": "#/$defs/skillIdArray" },
        "companions": { "$ref": "#/$defs/skillIdArray" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteRefs"],
      "properties": {
        "suiteRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec": { "type": "string", "minLength": 1, "maxLength": 50 },
        "runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
        "maintainers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "skillId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "domainId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)~[^/]*)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
      "maxLength": 100
    },
    "resourceScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[a-z][a-z0-9+.-]*:.+$"
    },
    "skillIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/skillId" }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "loadWhen"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "role": {
          "enum": ["reference", "script", "template", "asset", "evaluation"]
        },
        "mediaType": { "type": "string", "minLength": 3, "maxLength": 100 },
        "loadWhen": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
