flowchart LR
  accTitle: Registry and schema relationships
  accDescr: Schema-validated manifests and registry records feed one canonical registry. The registry produces router, catalog, and adapter views. Policy constrains activation; redacted runtime evidence supports evaluation and promotion.

  subgraph source["Canonical inputs"]
    M["Skill manifests"]
    R["Registry"]
    T["Router map"]
    P["Profile and policy"]
    V["Versioned schemas"]
  end

  V --> M
  V --> R
  V --> T
  V --> P

  subgraph views["Generated views"]
    S["Filtered search catalog"]
    A["Provider adapters"]
    C["Content-bound compiled bundle"]
  end

  M --> S
  R --> S
  P --> S
  M --> C
  R --> C
  T --> C
  P --> C
  C --> A
  C --> L["Activation lifecycle"]
  S --> L
  A --> L
  P --> L

  L --> E["Redacted telemetry"]
  E --> Q["Evaluation results"]
  Q --> G["Promotion and rollback policy"]
  G -. "govern next release" .-> R

