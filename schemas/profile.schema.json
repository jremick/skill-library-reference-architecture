{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillref:schema:profile:0.1",
  "title": "Skill profile",
  "description": "Fail-closed eligibility and permission rules applied before exposure or ranking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "defaultDecision",
    "resolution",
    "grants",
    "denials"
  ],
  "properties": {
    "$schema": { "const": "urn:skillref:schema:profile:0.1" },
    "schemaVersion": { "const": "0.1" },
    "id": { "$ref": "#/$defs/objectId" },
    "version": { "$ref": "#/$defs/semver" },
    "defaultDecision": { "const": "deny" },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denialsOverrideGrants", "unknownValues"],
      "properties": {
        "denialsOverrideGrants": { "const": true },
        "unknownValues": { "const": "deny" }
      }
    },
    "grants": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/grant" }
    },
    "denials": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/denial" }
    }
  },
  "$defs": {
    "objectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
      "maxLength": 100
    },
    "resourceScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[a-z][a-z0-9+.-]*:.+$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "skillIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/objectId" }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/objectId" }
        },
        "riskLevels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["low", "moderate", "high", "critical"] }
        }
      }
    },
    "permissionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "resourceScopes", "resourceRoles", "exposureModes"],
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "resourceScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resourceScope" }
        },
        "resourceRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["instructions", "reference", "script", "template", "asset", "evaluation"] }
        },
        "exposureModes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["prompt-visible", "router-retrievable"] }
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "permissions"],
      "properties": {
        "id": { "$ref": "#/$defs/objectId" },
        "selector": { "$ref": "#/$defs/selector" },
        "permissions": { "$ref": "#/$defs/permissionSet" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "denial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/objectId" },
        "selector": { "$ref": "#/$defs/selector" },
        "permissions": { "$ref": "#/$defs/permissionSet" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
