{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillref:schema:router-map:0.1",
  "title": "Router map",
  "description": "Portable routing topology and retrieval configuration. Authorization is external.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "sourceRegistryDigest",
    "policy",
    "retrieval",
    "routers"
  ],
  "properties": {
    "$schema": { "const": "urn:skillref:schema:router-map:0.1" },
    "schemaVersion": { "const": "0.1" },
    "id": { "$ref": "#/$defs/objectId" },
    "version": { "$ref": "#/$defs/semver" },
    "sourceRegistryDigest": { "$ref": "#/$defs/digest" },
    "sourceManifestDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "digest"],
        "properties": {
          "skillId": { "$ref": "#/$defs/objectId" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filterBeforeRanking", "denialsOverrideGrants", "ambiguityAction"],
      "properties": {
        "filterBeforeRanking": { "const": true },
        "denialsOverrideGrants": { "const": true },
        "ambiguityAction": { "enum": ["clarify", "decline"] }
      }
    },
    "retrieval": { "$ref": "#/$defs/retrieval" },
    "routers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/router" }
    }
  },
  "$defs": {
    "objectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "candidateLimit", "inspectLimit"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["none", "lexical", "semantic", "hybrid"] },
        "candidateLimit": { "type": "integer", "minimum": 1 },
        "inspectLimit": { "type": "integer", "minimum": 1 },
        "scoreThreshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "fallback": { "enum": ["decline", "clarify", "static-router"] }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": { "properties": { "mode": { "const": "none" } } }
        },
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "properties": { "mode": { "enum": ["lexical", "semantic", "hybrid"] } } }
        }
      ]
    },
    "exactAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phrase", "skillId"],
      "properties": {
        "phrase": { "type": "string", "minLength": 1, "maxLength": 200 },
        "skillId": { "$ref": "#/$defs/objectId" }
      }
    },
    "keywordRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "match", "skillId"],
      "properties": {
        "terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "match": { "enum": ["any", "all"] },
        "skillId": { "$ref": "#/$defs/objectId" },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["decline", "clarify", "search", "router"] },
        "targetRouterId": { "$ref": "#/$defs/objectId" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "router" } }, "required": ["action"] },
          "then": { "required": ["targetRouterId"] },
          "else": { "not": { "required": ["targetRouterId"] } }
        }
      ]
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "skills", "strategy", "fallback"],
      "properties": {
        "id": { "$ref": "#/$defs/objectId" },
        "domain": { "$ref": "#/$defs/objectId" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/objectId" }
        },
        "strategy": {
          "enum": ["exact", "static", "hierarchical", "filtered-search", "hybrid"]
        },
        "exactAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/exactAlias" }
        },
        "keywordRules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/keywordRule" }
        },
        "fallback": { "$ref": "#/$defs/fallback" }
      }
    }
  }
}
