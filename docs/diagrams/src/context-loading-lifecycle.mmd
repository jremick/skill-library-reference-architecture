flowchart TB
  accTitle: Context-loading lifecycle
  accDescr: A skill moves from installed material through validation, policy eligibility, visibility or retrieval, inspection, activation, conditional resource loading, execution, verification, and deactivation. Denials and failures remain explicit.

  A0["Cached bytes"] --> A["Installed package"]
  A --> B["Registered manifest digest"]
  B --> C{"Policy eligible?"}
  C -- "No" --> X["Denied or quarantined"]
  C -- "Yes" --> D{"Exposure path"}
  D --> E["Prompt-visible metadata"]
  D --> F["Router-retrievable record"]
  E --> G["Retrieved or selected candidate"]
  F --> G
  G --> H["Inspected"]
  H --> I{"Conflicts resolved?"}
  I -- "No" --> Y["Stop or review"]
  I -- "Yes" --> J["Version pinned and activated"]
  J --> K{"Resource condition met?"}
  K -- "Yes" --> L["Named resource loaded"]
  K -- "No" --> M["Execute instructions"]
  L --> M
  M --> N{"Outcome verified?"}
  N -- "Yes" --> O["Verified and deactivated"]
  N -- "No" --> P["Failure or incomplete evidence"]
  P -. "bounded retry" .-> G

  classDef system fill:#78909C,stroke:#607D8B,color:#FFFFFF;
  classDef automated fill:#20808D,stroke:#187078,color:#FFFFFF;
  classDef decision fill:#E8F4F6,stroke:#187078,color:#13343B;
  classDef success fill:#2E7D32,stroke:#2E7D32,color:#FFFFFF;
  classDef stop fill:#C62828,stroke:#C62828,color:#FFFFFF;

  class A0,A,B,E,F,G,H,J,L,M system;
  class C,D,I,K,N decision;
  class O success;
  class X,Y,P stop;
