flowchart TB
  accTitle: Context-loading lifecycle
  accDescr: Four compact stages separate inventory and policy, exposure, runtime disclosure, and outcome. Cached or installed material is not automatically visible; inspection is not activation; named resources load only when conditions are met; and verification remains distinct from execution.

  subgraph stages["Progressive disclosure"]
    direction LR
    I["<b>1 · Inventory and policy</b><br/>Cached → Installed → Registered → Eligible"]
    E["<b>2 · Exposure</b><br/>Prompt-visible <i>or</i> Router-retrievable<br/>→ Retrieved candidate"]
    R["<b>3 · Runtime disclosure</b><br/>Inspect → Resolve → Pin and activate<br/>→ Load named resources conditionally"]
    O["<b>4 · Outcome</b><br/>Execute → Evaluate → Deactivate"]

    I --> E --> R --> O
  end

  subgraph boundaries["Boundary states remain explicit"]
    direction LR
    X["Denied or quarantined<br/>before retrieval"]
    Y["Stop or review<br/>before activation"]
    S["Verified and deactivated"]
    P["Failure or incomplete evidence<br/>bounded retry only"]

    X ~~~ Y ~~~ S ~~~ P
  end

  stages -.-> boundaries

  classDef inventory fill:#78909C,stroke:#607D8B,color:#FFFFFF,stroke-width:2px;
  classDef exposure fill:#20808D,stroke:#187078,color:#FFFFFF,stroke-width:2px;
  classDef runtime fill:#20808D,stroke:#187078,color:#FFFFFF,stroke-width:2px;
  classDef outcome fill:#2E7D32,stroke:#2E7D32,color:#FFFFFF,stroke-width:2px;
  classDef stop fill:#C62828,stroke:#C62828,color:#FFFFFF,stroke-width:2px;
  classDef review fill:#FFF3E0,stroke:#C47530,color:#13343B,stroke-width:2px;

  class I inventory;
  class E exposure;
  class R runtime;
  class S outcome;
  class O review;
  class X,P stop;
  class Y review;

  style stages fill:#FFFFFF,stroke:#CBD5DA,stroke-width:1px
  style boundaries fill:#FFFFFF,stroke:#CBD5DA,stroke-width:1px
